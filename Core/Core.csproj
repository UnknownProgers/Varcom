<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<LangVersion>12.0</LangVersion>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AssemblyName>Varcom</AssemblyName>
		<RootNamespace>Varcom</RootNamespace>
		<PackageId>Varcom</PackageId>
		<Version>0.2.0-alpha.1</Version>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<Description>A command and console variable framework for games.</Description>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="../Generators/Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all"/>
		<None Include="../README.md" Pack="true" PackagePath="/"/>
		<None Include="../LICENSE" Pack="true" PackagePath="/"/>
		<None Include="../Generators/bin/$(Configuration)/netstandard2.0/Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs"
			  Visible="false"/>
	</ItemGroup>
</Project>
