<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<LangVersion>12.0</LangVersion>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AssemblyName>Varcom</AssemblyName>
		<RootNamespace>Varcom</RootNamespace>
		<PackageId>Varcom</PackageId>
		<Version>0.6.2-alpha.1</Version>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Authors>UnknownProgers</Authors>
		<Copyright>Copyright (c) 2026 UnknownProgers</Copyright>
		<PackageProjectUrl>https://github.com/UnknownProgers/Varcom</PackageProjectUrl>
		<RepositoryUrl>https://github.com/UnknownProgers/Varcom</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<PackageTags>commands;console;console-variables;games;source-generator;zero-allocation</PackageTags>
		<PackageReleaseNotes>https://github.com/UnknownProgers/Varcom/blob/master/CHANGELOG.md</PackageReleaseNotes>
		<PackageIcon>icon.png</PackageIcon>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Description>
			Engine-independent C# commands and console variables for games,
			with source-generated bindings, typed and text calls,
			queued execution, and allocation-free warmed execution paths.
		</Description>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="../Generators/Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"
						  PrivateAssets="all"/>
		<None Include="../README.md" Pack="true" PackagePath="/"/>
		<None Include="../LICENSE" Pack="true" PackagePath="/"/>
		<None Include="../assets/icon.png" Pack="true" PackagePath="/"/>
		<None Include="../Generators/bin/$(Configuration)/netstandard2.0/Generators.dll" Pack="true"
			  PackagePath="analyzers/dotnet/cs"
			  Visible="false"/>
	</ItemGroup>
</Project>
